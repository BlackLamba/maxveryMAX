# --- Общие настройки ---
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- PostgreSQL ---
POSTGRES_USER=maxuser
POSTGRES_PASSWORD=maxpass
POSTGRES_DB=maxevents
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000

# --- Worker ---
SYNC_INTERVAL_MINUTES=60
ENABLED_PROVIDERS=mock
TIMEPAD_API_TOKEN=
KUDAGO_API_TOKEN=

# --- Bot (MAX) ---
# Токен бота, полученный в @MasterBot / на платформе MAX для партнёров.
# Без заполнения бот не запустится (контейнер упадёт с понятной ошибкой).
MAX_BOT_TOKEN=
# Ник бота в MAX (совпадает с именем, под которым бот зарегистрирован).
BOT_NAME=maxveryMAX
# Публичный URL мини-приложения (для fallback-ссылки). В docker-compose внутри
# сети бэкенд доступен как http://backend:8000; внешний URL мини-аппа
# настраивается на платформе MAX для партнёров.
MINIAPP_BASE_URL=http://localhost:3000
# Как часто бот опрашивает backend на предмет новых уведомлений (секунд).
NOTIFICATIONS_POLL_INTERVAL_SECONDS=30

# --- MiniApp ---
MINIAPP_PORT=3000
