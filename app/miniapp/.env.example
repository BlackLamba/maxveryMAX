# --- miniapp (Vite) ---
# Базовый URL backend API для браузерного кода.
# ПУСТО (по умолчанию) = относительный /api:
#   - dev  → прокси Vite (см. vite.config.ts) на VITE_PROXY_TARGET;
#   - prod → прокси nginx (miniapp/nginx.conf) на backend:8000.
# Задавать полный URL нужно только если backend живёт на другом домене.
VITE_API_URL=

# Цель dev-прокси /api (только для `npm run dev`, в браузерный бандл НЕ попадает).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Порт dev-сервера (согласуется с MINIAPP_PORT в app/.env.example).
MINIAPP_PORT=3000
